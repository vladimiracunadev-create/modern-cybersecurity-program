# Entornos y dependencias
.venv/
venv/
env/
__pycache__/
*.py[cod]
node_modules/

# Herramientas y artefactos de laboratorio (¡nunca subir muestras reales de malware!)
*.exe
*.dll
*.bin
*.pcap
*.pcapng
samples/
malware/
loot/
*.raw
*.mem
*.vmem

# Credenciales y secretos
*.pem
*.key
*.env
.env
.env.*
secrets/
*.kdbx

# Sistema operativo / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Manifest interno de generación
classes/_manifest.json


# Salida de los laboratorios: informes y cachés que se generan al ejecutarlos
# (p. ej. el catálogo CISA KEV que descarga labs/devsecops-pipeline/priorizar.py).
labs/*/salida/

# Sitio generado para GitHub Pages (build artifact)
site/

# App móvil (Expo/React Native)
mobile/node_modules/
mobile/.expo/
mobile/dist/
# Salida de `expo export --platform web`, que el pipeline de release genera para
# comprobar el bundle antes de compilar el APK.
mobile/dist-web/
mobile/web-build/
mobile/android/
mobile/ios/
# Artefactos de release del APK (se publican como assets, nunca en el repo)
mobile/*.apk
mobile/*.aab
release-artifacts/

# Configuracion local del agente (settings.local.json, launch.json de preview)
.claude/
